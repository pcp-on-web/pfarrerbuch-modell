        <rdfs:label xml:lang="de">zugeordnete Stelle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inFamilie -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inFamilie">
