        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Geschlecht"/>
        <rdfs:comment xml:lang="de">Geschlecht einer Person</rdfs:comment>
        <rdfs:label xml:lang="de">Geschlecht</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatBildungseinrichtung -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatBildungseinrichtung">
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ausbildung"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Berufsabschluss"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Fortbildung"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Promotion"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Schulabschluss"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Schulausbildung"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Studienabschluss"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Studium"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Bildungseinrichtung"/>
