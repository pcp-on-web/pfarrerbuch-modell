        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familie"/>
        <rdfs:comment xml:lang="de">zugeordnete Familie.</rdfs:comment>
        <rdfs:label xml:lang="de">zugeordnete Familie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inKirchengemeinde -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inKirchengemeinde">
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Entsendung"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ordination"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Kirchengemeinde"/>
        <rdfs:comment xml:lang="de">Kirchengemeinde, in die ein Pfarrer, eine Pfarrerin berufen, entsendet oder in der er oder sie ordiniert wird.</rdfs:comment>
        <rdfs:label xml:lang="de">in einer Kirchengemeinde</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istKind -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istKind">
        <rdfs:subPropertyOf rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#gehoertzuFamilie"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familie"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Person"/>
        <rdfs:comment xml:lang="de">Kind, Adoptivkind oder Stiefkind in einer Familie</rdfs:comment>
        <rdfs:label xml:lang="de">ist Kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istPartner-in -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istPartner-in">
        <rdfs:subPropertyOf rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#gehoertzuFamilie"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familie"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Person"/>
        <rdfs:comment xml:lang="de">Partner bzw. Partnerin in einer Familie (Ehe oder Lebenspartnerschaft).</rdfs:comment>
        <rdfs:label xml:lang="de">Partner bzw. Partnerin in einer Familie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#kalenderSystem -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#kalenderSystem">
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ereignis"/>
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Periode"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Kalender"/>
        <rdfs:comment xml:lang="de">Kalendersystem: gregorianischer (Standard) oder julianischer Kalender</rdfs:comment>
        <rdfs:label xml:lang="de">Kalendersystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#verbundeneKirchengemeinde -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#verbundeneKirchengemeinde">
