    <!-- http://creativecommons.org/ns#attributionName -->


    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#attributionName"/>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#synonym -->


    <owl:AnnotationProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#synonym"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


