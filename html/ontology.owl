        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Kirchengemeinde"/>
        <rdfs:comment xml:lang="de">Kirchengemeinden, die der Kirchengemeinde zugeordnet, verbunden, etc. sind.</rdfs:comment>
        <rdfs:label xml:lang="de">verbundene Kirchengemeinde</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#zugeordneteKirchengemeinde -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#zugeordneteKirchengemeinde">
