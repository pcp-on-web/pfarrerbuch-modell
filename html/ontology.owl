    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#gehoertzuFamilie -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#gehoertzuFamilie">
        <rdfs:domain rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familie"/>
        <rdfs:range rdf:resource="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Person"/>
        <rdfs:comment xml:lang="de">Gehört einer Herkunftsfamilie an (Kind von). (Domänen-/Range-Richtung ggf. prüfen.) Bildet eine Familie.</rdfs:comment>
        <rdfs:label xml:lang="de">gehört zu Familie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#geschlecht -->


    <owl:ObjectProperty rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#geschlecht">
