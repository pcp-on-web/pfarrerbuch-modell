<?xml version="1.0"?>
<rdf:RDF xmlns="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#"
     xml:base="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocabulary="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#">
    <owl:Ontology rdf:about="http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#">
        <ns:attributionName>Participants of Workshop</ns:attributionName>
        <terms:license>http://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:modified>2023-09-12</terms:modified>
        <terms:modified>2026-06-01</terms:modified>
        <terms:modified>2026-07-17</terms:modified>
        <terms:modified>2026-10-09</terms:modified>
        <terms:title xml:lang="de">Vokabular Pfarrerbücher</terms:title>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>
    


