@prefix : <http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#> .

<http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#> rdf:type owl:Ontology ;
                                                               <http://creativecommons.org/ns#attributionName> "Participants of Workshop" ;
                                                               <http://purl.org/dc/terms/license> "http://creativecommons.org/licenses/by/4.0/" ;
                                                               <http://purl.org/dc/terms/modified> "2023-09-12" ,
                                                                                                   "2026-06-01" ,
                                                                                                   "2026-07-17" ,
                                                                                                   "2026-10-09" ;
                                                               <http://purl.org/dc/terms/title> "Vokabular Pfarrerbücher"@de .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#attributionName
<http://creativecommons.org/ns#attributionName> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#gehoertzuFamilie
:gehoertzuFamilie rdf:type owl:ObjectProperty ;
                  rdfs:domain :Familie ;
                  rdfs:range :Person ;
                  rdfs:comment "Gehört einer Herkunftsfamilie an (Kind von). (Domänen-/Range-Richtung ggf. prüfen.) Bildet eine Familie."@de ;
                  rdfs:label "gehört zu Familie"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#geschlecht
:geschlecht rdf:type owl:ObjectProperty ;
            rdfs:domain :Person ;
            rdfs:range :Geschlecht ;
            rdfs:comment "Geschlecht einer Person"@de ;
            rdfs:label "Geschlecht"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatBildungseinrichtung
:hatBildungseinrichtung rdf:type owl:ObjectProperty ;
                        rdfs:domain :Ausbildung ,
                                    :Berufsabschluss ,
                                    :Fortbildung ,
                                    :Promotion ,
                                    :Schulabschluss ,
                                    :Schulausbildung ,
                                    :Studienabschluss ,
                                    :Studium ;
                        rdfs:range :Bildungseinrichtung ;
                        rdfs:comment "Zugeordnete Bildungseinrichtung für Schule oder Studium."@de ;
                        rdfs:label "zugeordnete Bildungseinrichtung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatLebensabschnitt
:hatLebensabschnitt rdf:type owl:ObjectProperty ;
                    rdfs:domain :Pfarrer-in ;
                    rdfs:range :Lebensabschnitt ;
                    rdfs:comment "Lebensabschnitt von einem Pfarrer."@de ;
                    rdfs:label "hat Lebensabschnitt"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatOrt
:hatOrt rdf:type owl:ObjectProperty ;
        rdfs:domain :Bildungseinrichtung ,
                    :Kirchengemeinde ,
                    :Lebensabschnitt ,
                    :Stelle ;
        rdfs:range :Ort ;
        rdfs:comment "Geographischer Ort einer Stelle, eines Lebensabschnittes, einer Bildungseinrichtung oder einer Kirchengemeinde."@de ;
        rdfs:label "hat Ort"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#hatStelle
:hatStelle rdf:type owl:ObjectProperty ;
           rdfs:domain :Pfarrstelle ;
           rdfs:range :Stelle ;
           rdfs:comment "Über einen Zeitraum wahrgenommene Stelle."@de ;
           rdfs:label "zugeordnete Stelle"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inFamilie
:inFamilie rdf:type owl:ObjectProperty ;
           rdfs:domain :Familienzugehoerigkeit ;
           rdfs:range :Familie ;
           rdfs:comment "zugeordnete Familie."@de ;
           rdfs:label "zugeordnete Familie"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#inKirchengemeinde
:inKirchengemeinde rdf:type owl:ObjectProperty ;
                   rdfs:domain :Entsendung ,
                               :Ordination ;
                   rdfs:range :Kirchengemeinde ;
                   rdfs:comment "Kirchengemeinde, in die ein Pfarrer, eine Pfarrerin berufen, entsendet oder in der er oder sie ordiniert wird."@de ;
                   rdfs:label "in einer Kirchengemeinde"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istKind
:istKind rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :gehoertzuFamilie ;
         rdfs:domain :Familie ;
         rdfs:range :Person ;
         rdfs:comment "Kind, Adoptivkind oder Stiefkind in einer Familie"@de ;
         rdfs:label "ist Kind"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#istPartner-in
:istPartner-in rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :gehoertzuFamilie ;
               rdfs:domain :Familie ;
               rdfs:range :Person ;
               rdfs:comment "Partner bzw. Partnerin in einer Familie (Ehe oder Lebenspartnerschaft)."@de ;
               rdfs:label "Partner bzw. Partnerin in einer Familie"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#kalenderSystem
:kalenderSystem rdf:type owl:ObjectProperty ;
                rdfs:domain :Ereignis ,
                            :Periode ;
                rdfs:range :Kalender ;
                rdfs:comment "Kalendersystem: gregorianischer (Standard) oder julianischer Kalender"@de ;
                rdfs:label "Kalendersystem"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#verbundeneKirchengemeinde
:verbundeneKirchengemeinde rdf:type owl:ObjectProperty ;
                           rdfs:domain :Kirchengemeinde ;
                           rdfs:range :Kirchengemeinde ;
                           rdfs:comment "Kirchengemeinden, die der Kirchengemeinde zugeordnet, verbunden, etc. sind."@de ;
                           rdfs:label "verbundene Kirchengemeinde"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#zugeordneteKirchengemeinde
:zugeordneteKirchengemeinde rdf:type owl:ObjectProperty ;
                            rdfs:domain :Stelle ;
                            rdfs:range :Kirchengemeinde ;
                            rdfs:comment "Kirchengemeinde die einer (Pfarr-)Stelle zugeordnet ist."@de ;
                            rdfs:label "zugeordnete Kirchengemeinde"@de .


#################################################################
#    Data properties
#################################################################

###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#akademischerTitel
:akademischerTitel rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Person ;
                   rdfs:range rdfs:Literal ;
                   rdfs:comment "Akademischer Titel einer Person"@de ;
                   rdfs:label "Akademischer Titel"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#amtlicherTitel
:amtlicherTitel rdf:type owl:DatatypeProperty ;
                rdfs:domain :Person ;
                rdfs:range rdfs:Literal ;
                rdfs:comment "Amtlicher Titel einer Person (z.B. Kirchenrat, Superintendent)"@de ;
                rdfs:label "Amtlicher Titel"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#bis
:bis rdf:type owl:DatatypeProperty ;
     rdfs:domain :Periode ;
     rdfs:range xsd:date ;
     rdfs:comment "Exaktes Enddatum einer Periode in der Form YYYY"@de ;
     rdfs:label "bis"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#bisJahr
:bisJahr rdf:type owl:DatatypeProperty ;
         rdfs:domain :Periode ;
         rdfs:range xsd:gYear ;
         rdfs:comment "Endjahr einer Periode in der Form YYYY"@de ;
         rdfs:label "bis"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#datum
:datum rdf:type owl:DatatypeProperty ;
       rdfs:domain :Ereignis ;
       rdfs:range xsd:date ;
       rdfs:comment "Exaktes Datum eines Ereignisses in der Form YYYY-MM-TT"@de ;
       rdfs:label "Datum"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#jahr
:jahr rdf:type owl:DatatypeProperty ;
      rdfs:domain :Ereignis ;
      rdfs:range xsd:gYear ;
      rdfs:comment "Jahr eines Ereignisses in der Form YYYY"@de ;
      rdfs:label "Jahr"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#nachname
:nachname rdf:type owl:DatatypeProperty ;
          rdfs:domain :Person ;
          rdfs:range rdfs:Literal ;
          rdfs:comment "Nachname einer Person. (ggf. Namenszusätze/-varianten)"@de ;
          rdfs:label "Nachname"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#von
:von rdf:type owl:DatatypeProperty ;
     rdfs:domain :Periode ;
     rdfs:range xsd:date ;
     rdfs:comment "Exaktes Anfangsdatum einer Periode in der Form YYYY-MM-TT"@de ;
     rdfs:label "von"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#vonJahr
:vonJahr rdf:type owl:DatatypeProperty ;
         rdfs:domain :Periode ;
         rdfs:range xsd:gYear ;
         rdfs:comment "Anfangsjahr einer Periode in der Form YYYY"@de ;
         rdfs:label "von"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#vorname
:vorname rdf:type owl:DatatypeProperty ;
         rdfs:domain :Person ;
         rdfs:range rdfs:Literal ;
         rdfs:comment "Vorname(n) einer Person, getrennt mit Leerzeichen. (ggf. Namenszusätze/-varianten)"@de ;
         rdfs:label "Vorname"@de .


#################################################################
#    Classes
#################################################################

###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#AndereTaetigkeit
:AndereTaetigkeit rdf:type owl:Class ;
                  rdfs:subClassOf :Dienstlich ,
                                  :Periode ;
                  rdfs:comment "Andere Tätigkeit."@de ;
                  rdfs:label "Andere Tätigkeit"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ausbildung
:Ausbildung rdf:type owl:Class ;
            rdfs:subClassOf :Fachlich ,
                            :Periode ;
            rdfs:comment "Ausbildung."@de ;
            rdfs:label "Ausbildung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Berufsabschluss
:Berufsabschluss rdf:type owl:Class ;
                 rdfs:subClassOf :Ereignis ,
                                 :Fachlich ;
                 rdfs:comment "Berufsabschluss."@de ;
                 rdfs:label "Berufsabschluss"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Bestattung
:Bestattung rdf:type owl:Class ;
            rdfs:subClassOf :Ereignis ,
                            :Persoenlich ;
            rdfs:comment "Bestattung."@de ;
            rdfs:label "Bestattung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Bildungseinrichtung
:Bildungseinrichtung rdf:type owl:Class ;
                     rdfs:comment "Bildungseinrichtung bezogen auf Pfarrerin bzw. Pfarrer"@de ;
                     rdfs:label "Bildungseinrichtung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Dienstlich
:Dienstlich rdf:type owl:Class ;
            rdfs:subClassOf :Lebensabschnitt ;
            rdfs:comment "Dienstliche Angaben im Leben eines Pfarrers."@de ;
            rdfs:label "Dienstliche Angaben"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Eheschliessung
:Eheschliessung rdf:type owl:Class ;
                rdfs:subClassOf :Ereignis ,
                                :Persoenlich ;
                rdfs:comment "Eheschließung."@de ;
                rdfs:label "Eheschließung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Emeritierung
:Emeritierung rdf:type owl:Class ;
              rdfs:subClassOf :Dienstlich ,
                              :Ereignis ;
              rdfs:comment "Emeritierung."@de ;
              rdfs:label "Emeritierung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Entsendung
:Entsendung rdf:type owl:Class ;
            rdfs:subClassOf :Fachlich ,
                            :Periode ;
            rdfs:comment "Entsendung."@de ;
            rdfs:label "Entsendung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ereignis
:Ereignis rdf:type owl:Class ;
          rdfs:subClassOf :Lebensabschnitt ;
          rdfs:comment "Ereignis im Leben einer Pfarrerin oder eines Pfarrers bzw. einer Pastorin oder eines Pastors."@de ;
          rdfs:label "Ereignis"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#ErstesTheologischesExamen
:ErstesTheologischesExamen rdf:type owl:Class ;
                           rdfs:subClassOf :TheologischesExamen ;
                           rdfs:comment "Erstes Theologisches Examen."@de ;
                           rdfs:label "Erstes Theologisches Examen"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Fachlich
:Fachlich rdf:type owl:Class ;
          rdfs:subClassOf :Lebensabschnitt ;
          rdfs:comment "Fachliche Angaben im Leben einer Pfarrerin oder eines Pfarrers."@de ;
          rdfs:label "Fachliche Angaben"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familie
:Familie rdf:type owl:Class ;
         rdfs:comment "Beschreibt eine Familienkonstellation bestehend aus Kindern und Eltern (inkl. Pflegekindern, Adoptivkindern)"@de ;
         rdfs:label "Familie"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Familienzugehoerigkeit
:Familienzugehoerigkeit rdf:type owl:Class ;
                        rdfs:subClassOf :Periode ,
                                        :Persoenlich ;
                        rdfs:comment "Zugehörigkeit zur Herkunfts- oder gebildeten Familie."@de ;
                        rdfs:label "Familienzugehörigkeit"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Fortbildung
:Fortbildung rdf:type owl:Class ;
             rdfs:subClassOf :Fachlich ,
                             :Periode ;
             rdfs:comment "Fortbildung."@de ;
             rdfs:label "Fortbildung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Geburt
:Geburt rdf:type owl:Class ;
        rdfs:subClassOf :Ereignis ,
                        :Persoenlich ;
        rdfs:comment "Geburt."@de ;
        rdfs:label "Geburt"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Geschlecht
:Geschlecht rdf:type owl:Class ;
            rdfs:comment "Geschlecht einer Person"@de ;
            rdfs:label "Geschlecht"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Kalender
:Kalender rdf:type owl:Class ;
          rdfs:comment "Verwendetes Kalendersystem für Ereignisse und Perioden"@de ;
          rdfs:label "Kalendersystem"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Kirchengemeinde
:Kirchengemeinde rdf:type owl:Class ;
                 rdfs:comment "Kirchengemeinde."@de ;
                 rdfs:label "Kirchengemeinde"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Konfession
:Konfession rdf:type owl:Class ;
            rdfs:subClassOf :Periode ,
                            :Persoenlich ;
            rdfs:comment "Konfession."@de ;
            rdfs:label "Konfession"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Konversion
:Konversion rdf:type owl:Class ;
            rdfs:subClassOf :Ereignis ,
                            :Persoenlich ;
            rdfs:comment "Konversion."@de ;
            rdfs:label "Konversion"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Lebensabschnitt
:Lebensabschnitt rdf:type owl:Class ;
                 rdfs:comment "Lebensabschnitt einer Pfarrerin oder eines Pfarrers bzw. einer Pastorin oder eines Pastors"@de ;
                 rdfs:label "Lebensabschnitt"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Leitung
:Leitung rdf:type owl:Class ;
         rdfs:subClassOf :Dienstlich ,
                         :Periode ;
         rdfs:comment "Leitung einer Institution."@de ;
         rdfs:label "Leitung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ordination
:Ordination rdf:type owl:Class ;
            rdfs:subClassOf :Ereignis ,
                            :Fachlich ;
            rdfs:comment "Ordination."@de ;
            rdfs:label "Ordination"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ort
:Ort rdf:type owl:Class ;
     rdfs:comment "Geografischer Ort in einem Pfarrerbuch"@de ;
     rdfs:label "Ort"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Periode
:Periode rdf:type owl:Class ;
         rdfs:subClassOf :Lebensabschnitt ;
         rdfs:comment "Zeitabschnitt im Leben einer Pfarrerin oder eines Pfarrers bzw. einer Pastorin oder eines Pastors."@de ;
         rdfs:label "Periode"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Persoenlich
:Persoenlich rdf:type owl:Class ;
             rdfs:subClassOf :Lebensabschnitt ;
             rdfs:comment "Persönliche Angaben im Leben ener Pfarrerin bzw. eines Pfarrers."@de ;
             rdfs:label "Persönliche Angaben"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Person
:Person rdf:type owl:Class ;
        rdfs:comment "Stellt eine Person dar, die in der Datenbank verzeichnet ist, z.B. Pfarrerin oder Pfarrer, Familienmitglieder."@de ;
        rdfs:label "Person"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Pfarrer-in
:Pfarrer-in rdf:type owl:Class ;
            rdfs:subClassOf :Person ;
            rdfs:comment "Stellt eine Pfarrerin oder einen Pfarrer, bzw. Pastorin oder Pastor dar, welche in einem Pfarrerbuch verzeichnet ist."@de ;
            rdfs:label "Pfarrer:in oder Pastor:in"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Pfarrstelle
:Pfarrstelle rdf:type owl:Class ;
             rdfs:subClassOf :Dienstlich ,
                             :Periode ;
             rdfs:comment "Von einer Pfarrerin oder einem Pfarrer besetzte Stelle."@de ;
             rdfs:label "Pfarrstelle"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Promotion
:Promotion rdf:type owl:Class ;
           rdfs:subClassOf :Ereignis ,
                           :Fachlich ;
           rdfs:comment "Promotion."@de ;
           rdfs:label "Promotion"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Referent
:Referent rdf:type owl:Class ;
          rdfs:subClassOf :Dienstlich ,
                          :Periode ;
          rdfs:comment "Referent:in."@de ;
          rdfs:label "Referent:in"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Ruhestand
:Ruhestand rdf:type owl:Class ;
           rdfs:subClassOf :Dienstlich ,
                           :Periode ;
           rdfs:comment "Ruhestand."@de ;
           rdfs:label "Ruhestand"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Schulabschluss
:Schulabschluss rdf:type owl:Class ;
                rdfs:subClassOf :Ereignis ,
                                :Fachlich ;
                rdfs:comment "Schulabschluss."@de ;
                rdfs:label "Schulabschluss"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Schulausbildung
:Schulausbildung rdf:type owl:Class ;
                 rdfs:subClassOf :Fachlich ,
                                 :Periode ;
                 rdfs:comment "Schulausbildung."@de ;
                 rdfs:label "Schulausbildung"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Sonderpfarramt
:Sonderpfarramt rdf:type owl:Class ;
                rdfs:subClassOf :Dienstlich ,
                                :Periode ;
                rdfs:comment "Sonderpfarramt."@de ;
                rdfs:label "Sonderpfarramt"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Spezialseelsorge
:Spezialseelsorge rdf:type owl:Class ;
                  rdfs:subClassOf :Dienstlich ,
                                  :Periode ;
                  rdfs:comment "Spezialseelsorge: Krankenhausseelsorge, Anstaltsseelsorge, Gefängnisseelsorge, Notfallseelsorge usw."@de ;
                  rdfs:label "Spezialseelsorge"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Stelle
:Stelle rdf:type owl:Class ;
        rdfs:comment "Eine Stelle (Amt,Pfarrstelle) innerhalb einer Kirchengemeinde"@de ;
        rdfs:label "Stelle"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Studienabschluss
:Studienabschluss rdf:type owl:Class ;
                  rdfs:subClassOf :Ereignis ,
                                  :Fachlich ;
                  rdfs:comment "Studienabschluss."@de ;
                  rdfs:label "Studienabschluss"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Studium
:Studium rdf:type owl:Class ;
         rdfs:subClassOf :Fachlich ,
                         :Periode ;
         rdfs:comment "Studium."@de ;
         rdfs:label "Studium"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Taufe
:Taufe rdf:type owl:Class ;
       rdfs:subClassOf :Ereignis ,
                       :Persoenlich ;
       rdfs:comment "Taufe."@de ;
       rdfs:label "Taufe"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#TheologischesExamen
:TheologischesExamen rdf:type owl:Class ;
                     rdfs:subClassOf :Ereignis ,
                                     :Fachlich ;
                     rdfs:comment "Hierunter sind erstes und zweites Theologisches Examen zusammengefasst."@de ;
                     rdfs:label "Theologisches Examen"@de .


###  http://meta-pfarrerbuch.evangelische-archive.de/vocabulary#Tod
:Tod rdf:type owl:Class ;
     rdfs:subClassOf :Ereignis ,
                     :Persoenlich ;
     rdfs:comment "Tod."@de ;
     rdfs:label "Tod"@de .


